---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const WEB3FORMS_ACCESS_KEY = "a71704af-652c-4d55-ae09-8c59987b4999";

const asuntos = [
  "Información general",
  "Presupuesto de trastero",
  "Guardamuebles",
  "Servicio de taquillas",
  "Custodia documental",
  "Espacio para Autocaravanas",
  "Espacio para barcos",
  "Espacio para Quads o motos",
  "Otro",
];

const centros = ["Calvario", "Avda. de Madrid", "Camelias", "Mos"];
---

<Layout title="Contacta con Trasteros Vigo" description="¿Tienes alguna duda? Contacta con Trasteros Vigo y te responderemos lo antes posible.">
  <div class="flex flex-col min-h-screen bg-black">
    <Nav />

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 grow w-full">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-(--color-gold) hover:text-white transition-colors group mb-8"
      >
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Volver al inicio
      </a>

      <header class="text-center mb-12">
        <h1 class="italicamarilla text-4xl sm:text-5xl font-bold">Contacta con Trasteros Vigo</h1>
        <p class="mt-3 text-white/70 text-lg max-w-2xl mx-auto">
          ¿Tienes alguna duda? Escríbenos y te responderemos lo antes posible.
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-10 items-start">
        <!-- FORMULARIO -->
        <div class="bg-(--color-ink-soft) border-2 border-(--color-gold) rounded-2xl p-6 sm:p-8">
          <form id="form-contacto" class="space-y-5">
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="Nuevo mensaje de contacto - Trasteros Vigo" />
            <input type="hidden" name="from_name" value="Web Trasteros Vigo" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="nombre" class="block text-sm font-bold text-(--color-gold) mb-1.5">Nombre y apellidos</label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  required
                  placeholder="Tu nombre"
                  class="w-full rounded-lg bg-black border border-(--color-gold)/40 text-white placeholder-white/40 px-4 py-2.5 focus:border-(--color-gold) focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="telefono" class="block text-sm font-bold text-(--color-gold) mb-1.5">Teléfono</label>
                <input
                  id="telefono"
                  name="telefono"
                  type="tel"
                  required
                  placeholder="600 000 000"
                  class="w-full rounded-lg bg-black border border-(--color-gold)/40 text-white placeholder-white/40 px-4 py-2.5 focus:border-(--color-gold) focus:outline-none transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-bold text-(--color-gold) mb-1.5">Correo electrónico</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="tucorreo@ejemplo.com"
                class="w-full rounded-lg bg-black border border-(--color-gold)/40 text-white placeholder-white/40 px-4 py-2.5 focus:border-(--color-gold) focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="asunto" class="block text-sm font-bold text-(--color-gold) mb-1.5">Asunto</label>
              <select
                id="asunto"
                name="asunto"
                required
                class="w-full rounded-lg bg-black border border-(--color-gold)/40 text-white px-4 py-2.5 focus:border-(--color-gold) focus:outline-none transition-colors"
              >
                <option value="" disabled selected>Selecciona un asunto</option>
                {asuntos.map((a) => <option value={a}>{a}</option>)}
              </select>
            </div>

            <div>
              <label for="mensaje" class="block text-sm font-bold text-(--color-gold) mb-1.5">Mensaje</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                placeholder="Cuéntanos en qué podemos ayudarte..."
                class="w-full rounded-lg bg-black border border-(--color-gold)/40 text-white placeholder-white/40 px-4 py-2.5 focus:border-(--color-gold) focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="form-submit-btn"
              class="w-full rounded-full bg-(--color-gold) text-black font-bold text-base px-6 py-3.5 hover:bg-(--color-gold-dark) transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Enviar mensaje
            </button>

            <p id="form-feedback" class="hidden text-sm font-semibold text-center rounded-lg px-4 py-3"></p>
          </form>
        </div>

        <!-- CONTACTO DIRECTO -->
        <aside class="bg-(--color-ink-soft) border-2 border-(--color-gold) rounded-2xl p-6 sm:p-8">
          <h2 class="italicamarilla text-2xl font-bold mb-4">Cualquier duda, pregúntanos</h2>
          <p class="text-white/70 text-sm mb-6">
            Si necesitas más información sobre algún servicio que prestamos, no dudes en consultarnos.
          </p>

          <div class="flex items-start gap-4 mb-5">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-black border-2 border-(--color-gold) shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-(--color-gold)">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <p class="text-white/70 text-sm">Llámanos</p>
              <a href="tel:+34986953832" class="font-bold hover:text-(--color-gold) transition-colors">986 95 38 32</a>
            </div>
          </div>

          <div class="flex items-start gap-4 mb-8">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-black border-2 border-(--color-gold) shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-(--color-gold)">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 6-10 7L2 6"></path>
              </svg>
            </div>
            <div>
              <p class="text-white/70 text-sm">Escríbenos</p>
              <a href="mailto:info@trasterosvigo.com" class="font-bold hover:text-(--color-gold) transition-colors">info@trasterosvigo.com</a>
            </div>
          </div>

          <hr class="border-(--color-gold)/30 mb-6" />

          <h3 class="text-sm font-bold text-(--color-gold) mb-3 uppercase tracking-wider">Nuestros centros</h3>
          <ul class="space-y-2 text-white/80 text-sm">
            {centros.map((c) => (
              <li class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-(--color-gold) shrink-0">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path>
                </svg>
                {c}
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  const form = document.getElementById("form-contacto") as HTMLFormElement | null;
  const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement | null;
  const feedback = document.getElementById("form-feedback") as HTMLParagraphElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submitBtn || !feedback) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando...";
    feedback.classList.add("hidden");

    try {
      const formData = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: formData,
      });
      const result = await response.json();

      feedback.classList.remove("hidden");
      if (result.success) {
        feedback.textContent = "¡Gracias! Hemos recibido tu mensaje, te contactaremos muy pronto.";
        feedback.className = "text-sm font-semibold text-center rounded-lg px-4 py-3 bg-(--color-gold)/10 border border-(--color-gold) text-(--color-gold)";
        form.reset();
      } else {
        throw new Error(result.message || "Error al enviar el formulario");
      }
    } catch (error) {
      feedback.classList.remove("hidden");
      feedback.textContent = "No se ha podido enviar el mensaje. Prueba de nuevo o llámanos directamente.";
      feedback.className = "text-sm font-semibold text-center rounded-lg px-4 py-3 bg-red-500/10 border border-red-500 text-red-400";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar mensaje";
    }
  });
</script>
