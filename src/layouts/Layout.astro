---
import "../styles/global.css";
import SEO from "../components/Seo.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Analytics from "../components/Analytics.astro";

const {
  title = "Trasteros en Vigo",
  description = "Alquiler de trasteros y guardamuebles en Vigo. Trasteros de varios tamaños, acceso 24 horas y seguridad, al mejor precio.",
  image,
} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
    	<meta name="theme-color" content="#0A0A0A" />
    	<SEO title={title} excerpt={description} image={image} />
    	<Analytics />
	</head>
	<body>
		<slot />
		<CookieConsent />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
