---
import "../styles/global.css";
import SEO from "../components/Seo.astro";

const {
  title = "Trasteros en Vigo",
  description = "Alquiler de Trasteros y guardamubles en Vigo",
  image = "/src/assets/logo.svg",
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
    	<SEO title={title} description={description} image={image} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
