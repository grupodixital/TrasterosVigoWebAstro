---
import { Image } from "astro:assets";
import logo from "../assets/logo-cabeceza-trasteros-vigo.png";
---

<div class="max-lg:collapse bg-black lg:mb-0 shadow-sm w-full rounded-md">
  <input id="navbar-1-toggle" class="peer hidden italicamarilla " type="checkbox" />
  <label
    for="navbar-1-toggle"
    class="fixed italicamarilla inset-0 hidden max-lg:peer-checked:block"></label>
  <div class="collapse-title navbar italicamarilla">
    <div class="navbar-start">
      <label for="navbar-1-toggle" class="btn btn-ghost lg:hidden italicamarilla">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h8m-8 6h16"></path></svg
        >
      </label>
      <a href="/" class=" border text-xl"
        ><Image src={logo} alt="Trasteros Vigo" height="60" /></a
      >
    </div>
    <div class="navbar-center hidden lg:flex font-bold text-xl">
      <ul class="menu menu-horizontal px-11 texto20">
        <li><a href="/presupuesto" class="hoveramarillo">Presupuesto</a></li>
        <li>
          <details>
            <summary>Alquiler de Trasteros</summary>
            <ul class="p-2 bg-black w-140 z-1 bg-blend-darken">
              <li><a href="/alquiler-de-trasteros-a-particulares" class="hoveramarillo">Particulares</a></li>
              <li><a href="/alquiler-de-trasteros-a-empresas-o-autonomos" class="hoveramarillo">Empresas</a></li>
              <li><a href="/alquiler-de-trasteros-en-vigo-para-estudiantes" class="hoveramarillo">Estudiantes</a></li>
              <li>
                <a href="/alquiler-de-taquillas-en-vigo" class="hoveramarillo">Servicio de Taquillas</a>
              </li>
              <li><a href="/servicio-de-guardamuebles" class="hoveramarillo">Guardamuebles</a></li>
              <!-- <li>
                <a href="/parking" class="hoveramarillo">Parking Autocaravanas</a>
              </li>
              <li>
                <a href="/barcos" class="hoveramarillo">Espacio para Barcos</a>
              </li> -->
              <li>
                <a href="/preguntas-frecuentes-y-recomendaciones" class="hoveramarillo"
                  >FAQ - Preguntas Frecuentes</a>
                </li>
            </ul>
          </details>
        </li>
        <li>
          <details>
            <summary>Otros Servicios</summary>
            <ul class="p-2 bg-black w-140 z-1 bg-blend-darken">
              <li><a href="/alquiler-de-oficinas-en-vigo" class="hoveramarillo">Alquiler de Oficinas en Vigo</a></li>
              <li><a href="/domiciliacion-de-sociedades" class="hoveramarillo">Domiciliacion de Sociedades</a></li>
              <li><a href="/destruccion-de-documentos" class="hoveramarillo">Destrucción Documental</a></li>
              <li><a href="/custodia-documental" class="hoveramarillo">Custodia Documental</a></li>
            </ul>
          </details>
        </li>        
        <li><a href="/contacta-con-trasteros-vigo" class="hoveramarillo">Contactar</a></li>

      </ul>
    </div>
    <div class="navbar-end">
      <div class="flex flex-row items-center justify-center gap-4 my-8">
        <a
          href="https://www.facebook.com/TrasterosVigo"
          aria-label="Facebook"
          class="flex items-center justify-center w-8 h-8 rounded-full bg-[#1877F2] text-white hover:opacity-80 transition-opacity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-4 h-4"
          >
            <path
              d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
            ></path>
          </svg>
        </a>
        <a
          href="https://instagram.com/trasterosvigo"
          aria-label="Instagram"
          class="flex items-center justify-center w-8 h-8 rounded-full bg-linear-to-br from-[#feda75] via-[#d62976] to-[#4f5bd5] text-white hover:opacity-80 transition-opacity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="w-4 h-4"
          >
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </a>
        <a
          href="https://twitter.com/trasterosvigo"
          aria-label="Twitter"
          class="flex items-center justify-center w-8 h-8 rounded-full bg-[#1DA1F2] text-white hover:opacity-80 transition-opacity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-4 h-4"
          >
            <path
              d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.pinterest.es/trasterosvigo/"
          aria-label="Pinterest"
          class="flex items-center justify-center w-8 h-8 rounded-full bg-[#E60023] text-white hover:opacity-80 transition-opacity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-4 h-4"
          >
            <path
              d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.171-2.911 1.023 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.995-.285 1.202.6 2.181 1.785 2.181 2.146 0 3.796-2.263 3.796-5.531 0-2.892-2.078-4.915-5.045-4.915-3.437 0-5.46 2.578-5.46 5.243 0 1.039.399 2.151.898 2.756a.36.36 0 0 1 .083.345l-.334 1.36c-.053.222-.174.271-.402.163-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="collapse-content lg:hidden z-1 italicamarilla bg-black">
    <ul class="menu italicamarilla text-lg">
      <li><a href="/" class="text-lg">Trasteros Vigo</a></li>
      <li>
        <a href="/presupuesto" class="text-lg">Presupuesto</a>
        <ul>
              <li><a href="/alquiler-de-trasteros-a-particulares" class="hoveramarillo">Particulares</a></li>
              <li><a href="/alquiler-de-trasteros-a-empresas-o-autonomos" class="hoveramarillo">Empresas</a></li>
              <li><a href="/alquiler-de-trasteros-en-vigo-para-estudiantes" class="hoveramarillo">Estudiantes</a></li>
              <li>
                <a href="/alquiler-de-taquillas-en-vigo" class="hoveramarillo">Servicio de Taquillas</a>
              </li>
              <li><a href="/servicio-de-guardamuebles" class="hoveramarillo">Guardamuebles</a></li>
              <!-- <li>
                <a href="/parking" class="hoveramarillo">Parking Autocaravanas</a>
              </li>
              <li>
                <a href="/barcos" class="hoveramarillo">Espacio para Barcos</a>
              </li> -->
              <li>
                <a href="/preguntas-frecuentes-y-recomendaciones" class="hoveramarillo"
                  >FAQ - Preguntas Frecuentes</a>
                </li>
        </ul>
      </li>
        <li>
          <details>
            <summary>Otros Servicios</summary>
            <ul class="p-2 bg-black w-140 z-1 bg-blend-darken">
              <li><a href="/alquiler-de-oficinas-en-vigo" class="hoveramarillo">Alquiler de Oficinas en Vigo</a></li>
              <li><a href="/domiciliacion-de-sociedades" class="hoveramarillo">Domiciliacion de Sociedades</a></li>
              <li><a href="/destruccion-de-documentos" class="hoveramarillo">Destrucción Documental</a></li>
              <li><a href="/custodia-documental" class="hoveramarillo">Custodia Documental</a></li>
            </ul>
          </details>
        </li>      
      <li><a href="/contacta-con-trasteros-vigo" class="text-lg">Contactar</a></li>
    </ul>
  </div>
</div>
