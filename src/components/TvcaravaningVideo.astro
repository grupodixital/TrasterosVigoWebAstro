---
interface Props {
  videoId?: string;
  title?: string;
}

const { videoId , title = "Vídeo TVCaravaning" } = Astro.props;
---

<div class="w-full max-w-3xl mx-auto">
  <!-- Marco del televisor -->
  <div class="relative rounded-4xl bg-black border-4 border-(--color-gold) shadow-2xl p-3 md:p-5">
    <!-- sensor/cámara superior -->
    <div class="absolute left-1/2 -translate-x-1/2 top-1.5 w-2 h-2 rounded-full bg-neutral-700"></div>

    <!-- pantalla -->
    <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black ring-1 ring-black/60" data-yt-consent-embed data-video-id={videoId} data-video-title={title}>
      {videoId ? (
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-neutral-950 text-(--color-gold) p-4 text-center" data-yt-placeholder>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-14 h-14 opacity-80">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <p class="italicamarilla text-sm md:text-base">
            Este vídeo es de YouTube y requiere aceptar cookies para reproducirse.
          </p>
          <button type="button" class="rounded-full bg-(--color-gold) text-black font-bold text-xs sm:text-sm px-4 py-2" data-yt-accept-btn>
            Aceptar cookies y ver vídeo
          </button>
        </div>
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-neutral-950 text-(--color-gold)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-14 h-14 opacity-80">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <p class="italicamarilla text-sm md:text-base">Vídeo próximamente</p>
        </div>
      )}
    </div>

    <!-- placa de marca -->
    <div class="mt-2 md:mt-3 text-center">
      <span class="italicamarilla text-xs md:text-sm tracking-widest"><a href="https://caravaning.trasterosvigo.com/" target="_blank" rel="noopener noreferrer">TVCARAVANING</a></span>
    </div>
  </div>

  <!-- peana del televisor -->
  <div class="flex flex-col items-center">
    <div class="w-24 h-3 md:w-28 md:h-4 bg-linear-to-b from-neutral-800 to-black" style="clip-path: polygon(20% 0, 80% 0, 100% 100%, 0 100%);"></div>
    <div class="w-40 h-2 md:w-48 md:h-2.5 rounded-full bg-black/80 blur-[1px]"></div>
    <div class="w-56 h-3 md:w-64 md:h-3 rounded-full bg-black/30 blur-md -mt-1"></div>
  </div>
</div>

<script>
  import { getConsent, setConsent, onConsentChange } from "../scripts/cookie-consent";

  function loadVideo(container: HTMLElement) {
    const videoId = container.dataset.videoId;
    const videoTitle = container.dataset.videoTitle || "Vídeo";
    const placeholder = container.querySelector("[data-yt-placeholder]");
    if (!videoId || !placeholder) return;

    const iframe = document.createElement("iframe");
    iframe.className = "absolute inset-0 w-full h-full";
    iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}`;
    iframe.title = videoTitle;
    iframe.loading = "lazy";
    iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
    iframe.allowFullscreen = true;

    placeholder.replaceWith(iframe);
  }

  const containers = document.querySelectorAll<HTMLElement>("[data-yt-consent-embed][data-video-id]");

  containers.forEach((container) => {
    if (getConsent() === "accepted") {
      loadVideo(container);
      return;
    }

    const acceptBtn = container.querySelector("[data-yt-accept-btn]");
    acceptBtn?.addEventListener("click", () => {
      setConsent("accepted");
      loadVideo(container);
    });
  });

  onConsentChange((value) => {
    if (value !== "accepted") return;
    containers.forEach((container) => {
      if (container.querySelector("[data-yt-placeholder]")) {
        loadVideo(container);
      }
    });
  });
</script>

