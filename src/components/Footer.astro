---
import { Image } from "astro:assets";
import logo from "../assets/logo-cabeceza-trasteros-vigo.png";
import aetym from "../assets/aetym.png";
import selloCompleto from "../assets/IMAGEN_PARA_EMAIL_WEB-trasteros.jpg";
import fondosEuropeos from "../assets/fondos_europeos-trasteros-vigo.webp";
import bonoTalentoEmpresa from "../assets/Sub-BonoTalentoEmpresa.webp";
import igape from "../assets/igape-1024x114.jpg";
import ayudaFondosEuropeos from "../assets/ayudafondoseuropes-1024x74.jpg";
import xpandeDigital from "../assets/programa-xpande-digital-trasteros-vigo.jpg";

const anioActual = new Date().getFullYear();

const centros = [
  {
    nombre: "Calvario",
    introAfter: "del centro del Calvario es:",
    bloques: [
      { dia: "Lunes a jueves:", horas: "09:00 – 14:00 y 16:00 a 18:00" },
      { dia: "Viernes:", horas: "09:00 – 14:00" },
      { dia: "Sábados y domingos :", horas: "Cerrado" },
    ],
    agosto: "AGOSTO 9h a 15:30h, TARDES CERRADO",
    enlaceloc: "https://g.page/trasterosvigo",
  },
  {
    nombre: "Avda. Madrid",
    introAfter: "de trasteros vigo Avenida Madrid es:",
    bloques: [
      { dia: "Lunes a viernes:", horas: "09:00 – 14:00 y 16:00 a 18:00" },
      { dia: "Sábados:", horas: "10:00 – 13:30" },
      { dia: "Domingos:", horas: "Cerrado" },
    ],
    agosto: "AGOSTO 9h a 15:30h, TARDES CERRADO",
    enlaceloc: "https://g.page/trasterosvigo2",
  },
  {
    nombre: "Camelias",
    introAfter: "del centro de Camelias es:",
    bloques: [
      { dia: "Lunes a viernes:", horas: "09:00 – 14:00 y 16:00 a 18:00" },
      { dia: "Sábados y domingos:", horas: "Cerrado" },
    ],
    agosto: "AGOSTO 9h a 15:30h, TARDES CERRADO",
    enlaceloc: "https://goo.gl/maps/kfDY6CvNqeMCbq8n9",
  },
  {
    nombre: "Mos - Autocaravaning",
    introAfter: "Rúa Autovia 106, Nave F, Mos",
    bloques: [
      { dia: "Lunes a viernes:", horas: "09:00 – 14:00 " },
      { dia: "Sábados y domingos:", horas: "Cerrado" },
    ],
    agosto: "AGOSTO 9h a 13:30h, TARDES CERRADO",
    enlaceloc: "https://maps.app.goo.gl/Sgx1APUKzqgS9kZ19",
  },
];
---

<footer id="site-footer" class="bg-black">
  <div class="max-w-6xl mx-auto px-6 pt-8 pb-14">
    <div class="flex items-start justify-between">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-(--color-gold)">
        <rect x="2" y="7" width="8" height="15" rx="1.5"></rect>
        <rect x="13" y="2" width="8" height="20" rx="1.5"></rect>
      </svg>
      <a href="https://www.aetym.com" target="_blank" rel="noopener noreferrer" class="min-w-0">
        <Image src={aetym} alt="Alianza Española de Trasteros y Mini-Almacenes" height="50" class="h-8 sm:h-10 md:h-12 w-auto max-w-full" />
      </a>
    </div>

    <div class="flex flex-col items-center text-center -mt-6 w-full">
      <Image src={logo} alt="Trasteros Vigo" height="120" class="h-16 sm:h-24 md:h-28 lg:h-32 w-auto max-w-full" />

      <a
        href="#"
        class="mt-6 inline-block max-w-full rounded-full border-2 border-(--color-gold) text-(--color-gold) font-bold px-8 py-3 hover:bg-(--color-gold) hover:text-black transition-colors"
      >
        Solicitar presupuesto para un trastero
      </a>

      <h2 class="mt-8 w-full text-xl sm:text-2xl md:text-3xl font-bold text-(--color-gold)">
        Localización y Horarios <span class="font-normal opacity-80">para</span> alquilar un Trasteros en Vigo
      </h2>
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
      {centros.map((centro) => (
        <div class="border-2 border-(--color-gold) rounded-2xl p-6 text-white">
          <h3 class="text-center text-2xl font-bold text-(--color-gold) mb-3">{centro.nombre}</h3>
          <div class="flex justify-center mb-4">
            <a href={centro.enlaceloc} target="_blank" rel="noopener noreferrer" class="rounded-full bg-(--color-gold) text-black font-bold text-sm px-4 py-1.5 hover:bg-(--color-gold-dark) transition-colors">
              Localizar centro
            </a>
          </div>

          <p class="mb-3">
            Nuestro <strong class="font-bold text-(--color-gold)">horario de oficina</strong> {centro.introAfter}
          </p>

          {centro.bloques.map((bloque) => (
            <>
              <p class="font-bold text-(--color-gold) mb-1">{bloque.dia}</p>
              <p class="text-amber-400 mb-3">{bloque.horas}</p>
            </>
          ))}

          <p class="text-sm">{centro.agosto}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="bg-(--color-bg) py-10 px-6">
    <div class="flex justify-center">
      <Image src={selloCompleto} alt="Trasteros Vigo - Garantía y certificaciones ISO 9001 / ISO 14001" width="820" />
    </div>

    <div class="mt-10 flex flex-col items-center gap-10">
      <Image src={xpandeDigital} alt="Programa Xpande Digital: PRODAT GALICIA SL beneficiaria de Fondos Europeos FEDER con el apoyo de la Cámara de Comercio de Pontevedra, Vigo y Vilagarcía de Arousa" width="900" class="w-full max-w-3xl h-auto" />
      <Image src={fondosEuropeos} alt="Axudas a servizos modulares de asesoramento especializado a empresas galegas, cofinanciadas pola Unión Europea e Fondos Europeos" width="900" class="w-full max-w-3xl h-auto" />
      <Image src={bonoTalentoEmpresa} alt="Bonos Talento Empresa, cofinanciado pola Unión Europea e Fondos Europeos" width="900" class="w-full max-w-3xl h-auto" />

      <div class="w-full max-w-3xl">
        <Image src={igape} alt="Instituto Galego de Promoción Económica, Cofinanciado pola Unión Europea, Fondos Europeos" width="900" class="w-full h-auto" />

        <p class="mt-6 text-sm md:text-base text-(--color-ink)">
          Prodat Galicia S.L., <em>ha sido beneficiaria del Fondo Europeo de Desarrollo Regional cuyo objetivo</em> es la mejora de la competitividad de las PYMES, y gracias al cual ha puesto en marcha un Plan de Acción con el objetivo de impulsar el uso seguro y fiable del ciberespacio y la competitividad de las pymes durante el año 2024. Para ello ha contado con el apoyo del Programa Ciberseguridad de la Cámara de Comercio de Pontevedra, Vigo y Vilagarcía de Arousa. <strong>#EuropaSeSiente”</strong>
        </p>

        <hr class="my-6 border-neutral-300" />

        <Image src={ayudaFondosEuropeos} alt="Cofinanciado por la Unión Europea, Ministerio de Hacienda, Fondos Europeos, Cámara de Comercio de España" width="900" class="w-full h-auto" />
      </div>
    </div>
  </div>

  <div class="bg-black px-6 py-4 text-center text-sm text-white">
    <p>© Trasteros Vigo 2012 – {anioActual}</p>
    <p class="mt-1">
      <a href="/aviso-legal" class="text-(--color-gold) hover:underline">Aviso legal</a>
      <span class="mx-2 opacity-60">||</span>
      <a href="/politica-privacidad" class="text-(--color-gold) hover:underline">Política de Privacidad</a>
      <span class="mx-2 opacity-60">||</span>
      <a href="/politica-de-cookies" class="text-(--color-gold) hover:underline">Política de Cookies</a>
    </p>
  </div>

  <a
    href="#top"
    aria-label="Volver arriba"
    class="fixed bottom-4 right-4 z-50 flex items-center justify-center w-10 h-10 rounded-md bg-(--color-gold) text-black shadow-lg hover:bg-(--color-gold-dark) transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
      <path d="m18 15-6-6-6 6"></path>
    </svg>
  </a>
</footer>
