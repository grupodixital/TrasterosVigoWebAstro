---
interface Props {
  titulo: string;
  imagen: string;
  enlace: string;
  textoboton: string;
}

const {titulo, imagen, enlace, textoboton } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-6 w-full max-w-sm mx-auto py-8">
  
  <!-- 1. Título Arriba Centrado -->
  <!-- He añadido min-h para que las imágenes queden a la misma altura aunque el título tenga 1 o 2 líneas -->
  <h2 class="text-3xl lg:text-4xl font-bold text-center px-4 min-h-[3rem] flex items-center justify-center">
    {titulo}
  </h2>

  <!-- 2. Imagen Central -->
  <img
    src={imagen}
    class="w-full rounded-2xl shadow-2xl object-cover shrink-0"
    alt="Imagen descriptiva"
  />

  <!-- (Opcional) Si necesitas un texto breve, iría aquí -->
  <!-- <p class="text-center text-lg px-4">Aquí va tu texto</p> -->

  <!-- 3. Botón Debajo Centrado -->
  <a href={enlace} class="btn btn-primary w-full max-w-[80%] rounded-full mt-2 text-center">
    {textoboton}
  </a>

</div>