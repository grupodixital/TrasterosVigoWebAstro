---
import Ventaja from './Ventaja.astro';
---
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto my-16 px-4">
    <Ventaja
        variant="card"
        titulo="Control de acceso con registro"
        icono="control-acceso"
        descripcion="Entra y sal cuando lo necesites, tu acceso queda siempre registrado."
    />
    <Ventaja
        variant="card"
        titulo="Parking privado"
        icono="parking"
        descripcion="Aparca tu vehículo cerca de tu trastero sin complicaciones."
    />
    <Ventaja
        variant="card"
        titulo="Alarma conectada a central"
        icono="alarma"
        descripcion="Sistema de alarma conectado a central receptora las 24 horas."
    />
    <Ventaja
        variant="card"
        titulo="Video vigilancia 24 horas"
        icono="camara"
        descripcion="Instalaciones vigiladas por cámaras durante todo el día."
    />
    <Ventaja
        variant="card"
        titulo="Seguro multirriesgo"
        icono="seguro"
        descripcion="Tus pertenencias protegidas con un seguro multirriesgo incluido."
    />
    <Ventaja
        variant="card"
        titulo="Instalaciones adaptadas a vehículos"
        icono="vehiculos"
        descripcion="Espacios pensados para furgonetas, autocaravanas y remolques."
    />
</div>
