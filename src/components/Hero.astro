---
import InfoCabezera from "./Infocabezera.astro";
import Leftcabecera from "./Leftcabecera.astro";
import Rightcabecera from "./Rightcabecera.astro";
import Imagenlogo from "../assets/fondo-Trasteros-Vigo.webp";
---


<div
  class="hero min-h-screen"
  style={`background-image: url(${Imagenlogo.src});`}
>
  <div class="hero-overlay"></div>
  <div class="hero-content text-neutral-content text-center w-full max-w-none px-4">
    <div class="w-full">
        <div class="flex flex-col lg:flex-row items-center lg:items-start gap-8 lg:gap-4">
                <div class="basis-full lg:basis-1/5">
                  <Leftcabecera />
                </div>
                <div class="basis-full lg:basis-3/5">
                  <InfoCabezera />
                </div>
                <div class="basis-full lg:basis-1/5">
                  <Rightcabecera />
                </div>
            </div>
    </div>
  </div>
</div>