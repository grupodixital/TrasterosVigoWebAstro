---
import { Image } from "astro:assets";
import logocaravaning from "../assets/logo-caravaning-trasterosvigo.png";

---

<div class="flex flex-col items-center text-center gap-3 text-white">
  <p class="font-bold text-lg">
    Contacta con <span class="italicamarilla">trasteros Vigo</span>.
  </p>

  <a
    href="tel:"
    class="flex items-center justify-center w-16 h-16 rounded-2xl bg-black border-2 border-(--color-gold) hoveramarillo transition-colors"
    aria-label="Llamar a Trasteros Vigo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-(--color-gold)">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
  </a>
  <p class="max-w-56">
    Llámanos para <span class="font-bold italicamarilla">alquilar un trastero</span> en Vigo.
  </p>

  <a
    href="mailto:info@trasterosvigo.com"
    class="flex items-center justify-center w-16 h-16 rounded-2xl bg-black border-2 border-(--color-gold) hoveramarillo transition-colors"
    aria-label="Enviar correo a Trasteros Vigo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-(--color-gold)">
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 6-10 7L2 6"></path>
    </svg>
  </a>
  <p class="max-w-56">
    O envíanos un correo electrónico a:
    <br />
    <a href="mailto:info@trasterosvigo.com" class="font-bold italicamarilla">info@trasterosvigo.com</a>
  </p>
  <a href="https://tvcaravaning.com" target="_blank" rel="noopener noreferrer">
    <Image src={logocaravaning} alt="Logo TVCaravaning" height="250" />
  <div class="animate-bounce text-yellow-400 -rotate-10 text-3xl font-black">Reserva tu Espacio!</div>
  </a>
</div>
